{
  "name": "@shiftpilot/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Fastify API server",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsup",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "eval:claude": "tsx --env-file-if-exists=.env src/eval/run-eval.ts",
    "smoke:claude": "tsx --env-file-if-exists=.env src/eval/smoke.ts",
    "eval:openrouter": "tsx --env-file-if-exists=.env src/eval/run-eval.ts",
    "smoke:openrouter": "tsx --env-file-if-exists=.env src/eval/smoke-openrouter.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@shiftpilot/contracts": "workspace:*",
    "@shiftpilot/domain": "workspace:*",
    "@shiftpilot/provider": "workspace:*",
    "better-sqlite3": "^11.8.0",
    "drizzle-orm": "^0.38.0",
    "fastify": "^5.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.0.0",
    "drizzle-kit": "^0.30.0",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0"
  }
}
