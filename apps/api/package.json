{
  "name": "@shiftpilot/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Fastify API server",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@shiftpilot/contracts": "workspace:*",
    "@shiftpilot/domain": "workspace:*",
    "@shiftpilot/provider": "workspace:*",
    "fastify": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0"
  }
}
