# SHIFT PILOT environment template
# M0: default values work with zero configuration. Copy to apps/api/.env when you
# need to override anything (used by `pnpm --filter @shiftpilot/api start`).
# NEVER commit a real .env. NEVER commit real credentials.

# --- Server ---
# API listens on this port and host.
PORT=8787
HOST=localhost
# Origin allowed for CORS (the web app). Comma-separate multiple origins if needed.
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development

# --- AI provider ---
# fake  -> deterministic offline provider (development, demos, tests). No network. Default.
# claude -> real Anthropic Claude provider. NOT available in M0 — ships in M2
#           (docs/implementation-plan.md). The API fails fast with a clear message.
AI_PROVIDER=fake
# Per-request timeout for provider calls, in milliseconds (used by the real provider in M2).
AI_TIMEOUT_MS=30000

# --- Deferred to later milestones ---
# M2: Claude activation. Keep EMPTY until then. Key stays server-side only.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5
# M1: SQLite/Drizzle persistence.
# DATABASE_PATH=./data/shift-pilot.db