# SHIFT PILOT environment template
# Defaults work with zero configuration. Copy this file to apps/api/.env when you
# need to override anything; both `pnpm dev` and `pnpm start` load it.
# NEVER commit a real .env. NEVER commit real credentials.

# --- Server ---
# API listens on this port and host.
PORT=8787
HOST=localhost
# Single origin allowed for CORS (the web app).
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development

# --- Persistence ---
# SQLite file. Relative paths resolve against apps/api (the API's working
# directory); use an absolute path if you run migrations from elsewhere.
# ":memory:" is used by the test suite.
#
# In production point this at a PERSISTENT MOUNTED VOLUME, never inside the
# build output or the container's writable layer:
#   DATABASE_PATH=/data/shiftpilot.db
DATABASE_PATH=data/shiftpilot.db

# --- Single-service production mode ---
# Directory holding the BUILT web app. When set, the API process also serves the
# browser app, so the client's relative "/api" resolves on the same origin and
# no reverse proxy or second process is needed. Leave UNSET in development:
# Vite serves the app on :5173 and proxies /api here.
#   WEB_ROOT=/app/web            (the Docker image sets this)
#   WEB_ROOT=../web/dist         (running the built API from apps/api)
# A WEB_ROOT with no index.html in it is a boot-time failure, not a silent 404.
WEB_ROOT=

# --- AI provider ---
# fake   -> deterministic offline provider (development, demos, tests). No network,
#           no key, no cost. Default, and what CI always runs.
# claude -> real Anthropic Claude provider. Requires ANTHROPIC_API_KEY and
#           ANTHROPIC_MODEL below; the API refuses to start without them and
#           never falls back to the offline provider.
# openrouter -> real OpenRouter provider on the FREE route only. Requires
#           OPENROUTER_API_KEY and OPENROUTER_MODEL below; paid models are
#           rejected at startup and before every inference. Never falls back.
AI_PROVIDER=fake

# --- AI cost + safety controls (apply to the intake endpoint) ---
# Per-request timeout, in milliseconds. The request is aborted, not just abandoned.
AI_TIMEOUT_MS=30000
# Hard cap on one intake's characters. Rejected with 422 before any provider call.
AI_MAX_INPUT_CHARS=8000
# Fixed-window throttle on the AI-backed endpoint: requests per window, per client IP.
AI_RATE_LIMIT=10
AI_RATE_LIMIT_WINDOW_MS=60000

# --- Claude activation (required when AI_PROVIDER=claude) ---
# Read server-side only. Never sent to the browser, never logged, never committed.
# Create a key in the Anthropic console and put the real value in apps/api/.env.
ANTHROPIC_API_KEY=

# Model identifier. Deliberately has NO default in code: model ids change, and a
# hard-coded one would rot or silently pin an outdated model.
#
# Ids below were checked against Anthropic's models documentation in Aug 2026.
# Re-check before you rely on them — that is exactly why none is hard-coded.
#   claude-sonnet-5             good default: fast, cheaper, ample for extraction
#   claude-opus-5               most capable of the general-purpose tier
#   claude-haiku-4-5-20251001   cheapest and fastest
# Whichever you pick, `pnpm smoke:claude` confirms your account can call it
# before you spend anything on the full evaluation.
ANTHROPIC_MODEL=

# Hard ceiling on generated tokens per request (includes any model thinking).
ANTHROPIC_MAX_OUTPUT_TOKENS=4096

# Bounded retries for transient provider failures. The SDK applies exponential
# backoff; the application adds no second retry layer. AI_TIMEOUT_MS is the TOTAL
# budget and is divided across the attempts this allows.
ANTHROPIC_MAX_RETRIES=2

# Optional reasoning-effort hint, and a real cost lever: on current models effort
# defaults to "high" on the Claude API, which is more than task extraction needs.
# Setting "low" reduces cost and latency. Left unset by default because not every
# model accepts the parameter (sending it to one that does not is a 400).
# ANTHROPIC_EFFORT=low

# --- OpenRouter activation (required when AI_PROVIDER=openrouter) ---
# FREE-TIER ONLY. Read server-side only. Never sent to the browser, never
# logged, never committed. Create a key in the OpenRouter console and put the
# real value in apps/api/.env.
OPENROUTER_API_KEY=

# Model identifier. MUST be a free route:
#   openrouter/free                      routes to any available free model
#   <vendor>/<model>:free                e.g. meta-llama/llama-3.3-70b-instruct:free
# Any other value (paid ids, no :free suffix) is REJECTED by a hard guard before
# any request. There is no paid fallback: if the free route is rate-limited or
# unavailable the call fails.
#
# Prefer a PINNED `<vendor>/<model>:free` id over the `openrouter/free` alias.
# Both are free, but the alias re-picks the model per request, and a reasoning
# model that spends the whole output budget on hidden reasoning returns an empty
# completion (seen live as `ai_invalid_response`). Pinning makes runs
# reproducible; this is the model the live evaluation used.
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free

# OpenAI-compatible endpoint. Override only if you proxy OpenRouter elsewhere.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Hard ceiling on generated tokens per request. Free-tier routes cap output, so
# keep this small; extraction needs very little.
OPENROUTER_MAX_OUTPUT_TOKENS=1024

# Bounded retries for HTTP 429 ONLY (free-tier quotas are shared), against the
# exact same free route, with backoff. Default 0: a rate-limited free route
# FAILS rather than burning time. A retry can never reach a different model.
# 2 is a good value for a shared demo route. Attempts are budgeted against a
# shared deadline, not an equal share each, so a cheap 429 does not shrink the
# window the real generation attempt gets; a backoff that would outlast the
# deadline reports the rate limit instead of sleeping into a timeout.
OPENROUTER_MAX_RETRIES=2
